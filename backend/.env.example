SECRET_KEY=replace-with-a-generated-secret-key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
GEMINI_API_KEY=

# Production defaults: entrypoint seeds only when SEED_DEMO is exactly true.
SEED_DEMO=false
SEED_DEMO_FORCE=false

# Database configuration (PostgreSQL for Docker/Production/Testing, default empty for SQLite)
DB_ENGINE=
DB_NAME=moneymanagement
DB_USER=replace-with-database-user
DB_PASSWORD=replace-with-database-password
DB_HOST=localhost
DB_PORT=5432

# Fallback test DB settings
TEST_DB=
TEST_DB_NAME=moneymanagement_test
TEST_DB_USER=test_user
TEST_DB_PASSWORD=test_password
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=5433

# Auth & Cookies
AUTH_COOKIE_SECURE=True
AUTH_COOKIE_SAMESITE=Lax

# CORS & CSRF additional origins (comma-separated)
EXTRA_CORS_ORIGINS=
